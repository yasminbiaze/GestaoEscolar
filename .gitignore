# Ignore Visual Studio temporary files, build outputs, and user-specific files
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Build artifacts
bin/
obj/
**/bin/
**/obj/

# Visual Studio Code workspace settings
.vscode/

# Rider project settings
.idea/
*.sln.iml

# NuGet
*.nupkg
packages/
*.snupkg
*.symbols.nupkg

# Local test and build logs
*.log
*.tlog
*.lastbuildstate

# OS generated files
Thumbs.db
Desktop.ini
.DS_Store

# Temporary files
*.tmp
*.temp
~$*
*.cache

# User-specific files
*.rsuser
*.userprefs

# Mono Auto Generated Files
mono_crash.*

# Others
*.dbmdl
*.dbproj.schemaview

# Do not ignore source code or project files
!/**/*.csproj
!/**/*.sln
